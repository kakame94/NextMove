# Klaris Web — copy to .env.local and fill before `npm run dev`
# Same Supabase project as the iOS app (RLS enforced server-side).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Surfaced in the footer + Sentry release tag
NEXT_PUBLIC_APP_VERSION=0.1.0

# Absolute app URL (Stripe success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketplace wallet — Stripe (server-only, NEVER prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Service-role key — server-only, bypasses RLS. Used by the Stripe webhook to
# credit wallets via record_stripe_topup. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
